{% extends 'base.html.twig' %}

{% block title %}Publication de {{ post.auteurId.prenom }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css">
    <link rel="stylesheet" href="{{ asset('css/etudiants.css') }}">
    <style>
        .post-container { max-width: 750px; margin: 40px auto; padding: 0 20px; font-family: var(--font-display); }
        .back-link { display: inline-flex; align-items: center; gap: 8px; color: var(--text-muted); text-decoration: none; font-weight: 500; font-size: 0.9rem; margin-bottom: 24px; transition: color 0.15s; }
        .back-link:hover { color: var(--text-primary); }
        
        .main-post { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-xl); padding: 30px; margin-bottom: 30px; }
        .post-header { display: flex; align-items: center; gap: 16px; margin-bottom: 20px; padding-bottom: 20px; border-bottom: 1px solid var(--border); }
        .post-avatar { width: 50px; height: 50px; background: linear-gradient(135deg, #3b5a80, #293f5c); border-radius: 50%; display: flex; align-items: center; justify-content: center; color: white; font-weight: bold; font-size: 1.3rem; }
        .post-author-name { font-weight: 800; color: var(--text-primary); font-size: 1.15rem; margin: 0 0 4px; }
        .post-meta { font-size: 0.8rem; color: var(--text-muted); font-family: var(--font-mono); }
        .post-group-badge { display: inline-block; background: var(--surface-3); color: var(--blue); padding: 2px 8px; border-radius: 6px; font-weight: 600; margin-left: 6px; }
        
        .post-content { color: #f0f0f0; font-size: 1.15rem; line-height: 1.7; word-wrap: break-word; }

        .comments-section { margin-top: 40px; }
        .comments-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; }
        .comments-title { color: var(--text-primary); font-size: 1.3rem; margin: 0; display: flex; align-items: center; gap: 10px; font-weight: 700; }
        
        .comment-card { background: var(--surface-2); border: 1px solid var(--border-light); border-radius: var(--radius-lg); padding: 20px; margin-bottom: 16px; position: relative; }
        .comment-card::before { content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 4px; background: var(--blue); border-top-left-radius: var(--radius-lg); border-bottom-left-radius: var(--radius-lg); opacity: 0.7; }
        .comment-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; }
        .comment-author { font-weight: 600; color: #e0e0e0; display: flex; align-items: center; gap: 8px; font-size: 0.95rem; }
        .comment-date { font-size: 0.75rem; color: var(--text-muted); font-family: var(--font-mono); }
        .comment-content { color: #ccc; line-height: 1.6; margin: 0; font-size: 0.95rem; }
    </style>
{% endblock %}

{% block body %}
<div class="post-container">

    <a href="{{ path('app_post_index') }}" class="back-link">
        <i class="ti ti-arrow-left"></i> Retour au fil d'actualité
    </a>

    {# ── THE ORIGINAL POST ── #}
    <div class="main-post">
        <div class="post-header">
            <div class="post-avatar">
                {{ post.auteurId.prenom|slice(0,1)|upper }}
            </div>
            <div>
                <h3 class="post-author-name">{{ post.auteurId.prenom }} {{ post.auteurId.nom }}</h3>
                <div class="post-meta">
                    Publié le {{ post.dateCreation|date('d/m/Y à H:i') }} dans 
                    <span class="post-group-badge"><i class="ti ti-users-group" style="margin-right: 4px;"></i>{{ post.groupId.nom }}</span>
                </div>
            </div>
        </div>
        <div class="post-content">
            {{ post.contenu|nl2br }}
        </div>
    </div>

    {# ── COMMENTS SECTION ── #}
    <div class="comments-section">
        <div class="comments-header">
            <h3 class="comments-title">
                <i class="ti ti-messages" style="color: var(--blue);"></i> Commentaires ({{ post.commentaires|length }})
            </h3>
            <a href="{{ path('app_commentaire_new', {'id': post.id}) }}" class="etu-btn-primary" style="text-decoration: none; font-size: 0.85rem; padding: 8px 16px;">
                <i class="ti ti-plus"></i> Répondre
            </a>
        </div>

        <div>
            {% for comment in post.commentaires %}
                <div class="comment-card">
                    <div class="comment-header">
                        <div class="comment-author">
                            <i class="ti ti-user-circle" style="color: var(--text-muted); font-size: 1.2rem;"></i>
                            {{ comment.auteurId.prenom }} {{ comment.auteurId.nom }}
                        </div>
                        <div class="comment-date">{{ comment.dateCreation|date('d M Y, H:i') }}</div>
                    </div>
                    <p class="comment-content">{{ comment.contenu|nl2br }}</p>
                </div>
            {% else %}
                <div class="etu-empty" style="background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-xl); padding: 40px 20px;">
                    <i class="ti ti-message-2-off" style="font-size: 2.5rem; color: var(--text-dim); margin-bottom: 15px;"></i>
                    <h4 style="color: var(--text-primary); margin: 0 0 5px; font-weight: 600;">Aucun commentaire</h4>
                    <p style="color: var(--text-muted); font-size: 0.9rem; margin: 0;">Soyez le premier à partager votre avis !</p>
                </div>
            {% endfor %}
        </div>
    </div>

</div>
{% endblock %}
