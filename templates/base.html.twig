{# templates/base.html.twig #}
<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}INSAT Portal{% endblock %}</title>
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/dist/tabler-icons.min.css">
        <link rel="stylesheet" href="{{ asset('css/styles.css') }}">
        <link rel="stylesheet" href="{{ asset('css/etudiants.css') }}">
        {% block stylesheets %}{% endblock %}
    </head>
    <body class="bg">
        <nav class="topbar" style="display: flex; align-items: center; justify-content: space-between; padding: 0 40px; height: 70px; background: #111; border-bottom: 1px solid #2e2e2e; position: sticky; top: 0; z-index: 1000;">
            <div class="brand">
                <a href="{{ path('app_post_index') }}">
                    <img src="{{ asset('resources/logo.svg') }}" alt="INSAT" style="height: 30px;">
                </a>
            </div>

            <div class="nav-links" style="display: flex; gap: 25px; align-items: center;">
                <a href="{{ path('app_post_index') }}" style="color: #fff; text-decoration: none; font-weight: 500;">
                    <i class="ti ti-news"></i> Blog
                </a>

                {% if is_granted('ROLE_ADMIN') %}
                    <a href="{{ path('app_user_index') }}" style="color: #888; text-decoration: none;">
                        <i class="ti ti-users"></i> Étudiants
                    </a>
                    <a href="{{ path('app_demande_index') }}" style="color: #888; text-decoration: none;">
                        <i class="ti ti-settings"></i> Administration
                    </a>
                {% endif %}

                <a href="{{ path('get_my_demande') }}" style="color: #888; text-decoration: none;">
                    <i class="ti ti-file-text"></i> Mes Demandes
                </a>
            </div>

            <div class="user-menu" style="color: #fff;">
                {% if app.user %}
                    <span style="font-size: 0.9rem; margin-right: 15px; color: #666;">{{ app.user.prenom }} {{ app.user.nom }}</span>
                    <a href="{{ path('app_logout') }}" style="color: #f87171; text-decoration: none;"><i class="ti ti-logout"></i></a>
                {% endif %}
            </div>
        </nav>

        <div class="container">
            {% block body %}{% endblock %}
        </div>
    </body>
</html>
