{% extends 'base.html.twig' %}

{% block title %}Mon Flux - INSAT{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css">
    <link rel="stylesheet" href="{{ asset('css/etudiants.css') }}">
    <style>
        .feed-container { max-width: 850px; margin: 40px auto; padding: 0 20px; font-family: var(--font-display); }
        .post-card { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-xl); padding: 24px; margin-bottom: 24px; transition: transform 0.2s, box-shadow 0.2s; }
        .post-card:hover { transform: translateY(-2px); box-shadow: 0 8px 30px rgba(0,0,0,0.4); border-color: var(--border-light); }
        .post-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 16px; }
        .post-author-info { display: flex; align-items: center; gap: 12px; }
        .post-avatar { width: 42px; height: 42px; background: linear-gradient(135deg, #3b5a80, #293f5c); border-radius: 50%; display: flex; align-items: center; justify-content: center; color: white; font-weight: bold; font-size: 1.1rem; }
        .post-author-name { font-weight: 700; color: var(--text-primary); font-size: 1rem; margin-bottom: 2px; }
        .post-date { font-size: 0.75rem; color: var(--text-muted); font-family: var(--font-mono); }
        .post-badge { background: var(--surface-3); border: 1px solid var(--border-light); color: var(--blue); padding: 6px 12px; border-radius: 100px; font-size: 0.75rem; font-family: var(--font-mono); display: inline-flex; align-items: center; gap: 6px; font-weight: 600; letter-spacing: 0.02em; }
        .post-content { color: #e0e0e0; font-size: 1.05rem; line-height: 1.6; margin-bottom: 20px; word-wrap: break-word; }
        .post-actions { display: flex; gap: 12px; padding-top: 16px; border-top: 1px solid var(--border); }
        .action-btn { display: inline-flex; align-items: center; gap: 8px; padding: 8px 16px; border-radius: var(--radius-lg); font-size: 0.85rem; font-weight: 600; text-decoration: none; transition: all 0.15s; }
        .action-btn-primary { background: var(--text-primary); color: var(--bg); }
        .action-btn-primary:hover { opacity: 0.9; transform: translateY(-1px); }
        .action-btn-secondary { background: transparent; border: 1px solid var(--border-light); color: var(--text-muted); }
        .action-btn-secondary:hover { color: var(--text-primary); border-color: var(--border-hover); background: var(--surface-2); }
    </style>
{% endblock %}

{% block body %}
<div class="feed-container">

    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 40px;">
        <div>
            <h1 style="color: var(--text-primary); font-size: 2.2rem; margin: 0; display: flex; align-items: center; gap: 12px; font-weight: 800; letter-spacing: -0.04em;">
                <i class="ti ti-activity-heartbeat" style="color: var(--blue);"></i> Mon Flux
            </h1>
            <p style="color: var(--text-muted); margin: 5px 0 0; font-size: 0.9rem;">
                Découvrez les dernières publications de vos groupes
            </p>
        </div>
        <a href="{{ path('app_groupe_index') }}" class="action-btn action-btn-secondary" style="background: var(--surface-2);">
            <i class="ti ti-search"></i> Parcourir les groupes
        </a>
    </div>

    {% for post in posts %}
        <div class="post-card">
            <div class="post-header">
                <div class="post-author-info">
                    <div class="post-avatar">
                        {{ post.auteurId.prenom|slice(0,1)|upper }}
                    </div>
                    <div>
                        <div class="post-author-name">{{ post.auteurId.prenom }} {{ post.auteurId.nom }}</div>
                        <div class="post-date">{{ post.dateCreation|date('d M Y, H:i') }}</div>
                    </div>
                </div>
                <div class="post-badge">
                    <i class="ti ti-users-group"></i> {{ post.groupId.nom }}
                </div>
            </div>

            <div class="post-content">
                {{ post.contenu|nl2br }}
            </div>

            <div class="post-actions">
                <a href="{{ path('app_post_show', {'id': post.id}) }}" class="action-btn action-btn-secondary">
                    <i class="ti ti-message-circle"></i> Commenter ({{ post.commentaires|length }})
                </a>
                {% if app.user == post.auteurId %}
                    <a href="{{ path('app_post_edit', {'id': post.id}) }}" class="action-btn action-btn-secondary" style="margin-left: auto;">
                        <i class="ti ti-pencil"></i> Modifier
                    </a>
                {% endif %}
            </div>
        </div>
    {% else %}
        <div class="etu-empty" style="background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-xl); padding: 60px 20px;">
            <i class="ti ti-ghost" style="font-size: 3rem; color: var(--text-dim); margin-bottom: 20px;"></i>
            <h3 style="color: var(--text-primary); margin-bottom: 10px;">Votre flux est vide</h3>
            <p style="color: var(--text-muted); max-width: 400px; margin: 0 auto 20px;">
                Rejoignez des groupes pour voir les publications de la communauté INSAT.
            </p>
            <a href="{{ path('app_groupe_index') }}" class="action-btn action-btn-primary">
                Découvrir les groupes
            </a>
        </div>
    {% endfor %}

</div>
{% endblock %}
