{% extends 'base.html.twig' %}

{% block title %}Mes Reclamations{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css">
    <link rel="stylesheet" href="{{ asset('css/etudiants.css') }}">
{% endblock %}

{% block body %}
<div class="etu-page">
    <div class="etu-header">
        <h1 class="etu-header-title">Reclamations</h1>
    </div>

    <div class="etu-table-wrap">
        <table class="etu-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Date Creation</th>
                    <th>Statut</th>
                    <th>Controle</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for reclamation in reclamations %}
                <tr>
                    <td>{{ reclamation.id }}</td>
                    <td>{{ reclamation.dateCreation ? reclamation.dateCreation|date('d/m/Y') : '' }}</td>
                    <td>{{ reclamation.statut.value }}</td>
                    <td>{{ reclamation.controleId }}</td>
                    <td class="etu-td-actions">
                        <a href="{{ path('app_reclamation_show', {'id': reclamation.id}) }}" class="etu-btn-icon"><i class="ti ti-eye"></i></a>
                        <a href="{{ path('app_reclamation_edit', {'id': reclamation.id}) }}" class="etu-btn-icon"><i class="ti ti-pencil"></i></a>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="5">no records found</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
