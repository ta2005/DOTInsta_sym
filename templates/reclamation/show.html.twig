{% extends 'base.html.twig' %}

{% block title %}Reclamation{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css">
    <link rel="stylesheet" href="{{ asset('css/etudiants.css') }}">
{% endblock %}

{% block body %}
<div class="etu-page" style="max-width: 800px;">
    <h1 class="etu-header-title">Reclamation #{{ reclamation.id }}</h1>

    <div class="etu-filter-card">
        <p><strong>Controle:</strong> {{ reclamation.controleId }}</p>
        <p><strong>Date:</strong> {{ reclamation.dateCreation|date('d/m/Y') }}</p>
        <p><strong>Statut:</strong> {{ reclamation.statut.value }}</p>
        <p><strong>Message:</strong></p>
        <p style="background: var(--surface-2); padding: 15px; border-radius: 8px;">{{ reclamation.message }}</p>
    </div>

    <div style="margin-top: 15px;">
        <a href="{{ path('app_reclamation_index') }}" class="etu-btn-secondary">Retour à la liste</a>
        <a href="{{ path('app_reclamation_edit', {'id': reclamation.id}) }}" class="etu-btn-primary">Modifier</a>
    </div>
</div>
{% endblock %}
