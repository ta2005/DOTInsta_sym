{% extends 'base.html.twig' %}

{% block title %}Nouvelle Reclamation{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css">
    <link rel="stylesheet" href="{{ asset('css/etudiants.css') }}">
{% endblock %}

{% block body %}
<div class="etu-page" style="max-width: 600px;">
    <h1 class="etu-header-title">Créer une réclamation</h1>

    <div class="etu-filter-card">
        {{ form_start(form) }}
            {{ form_widget(form) }}
            <button class="etu-btn-primary" style="margin-top: 15px;">Enregistrer</button>
        {{ form_end(form) }}
    </div>

    <a href="{{ path('app_reclamation_index') }}" class="etu-btn-secondary" style="margin-top: 15px; display: inline-block;">Retour à la liste</a>
</div>
{% endblock %}
