{% extends 'base.html.twig' %}

{% block title %}Connexion — INSAT{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/login.css') }}">
{% endblock %}

{% block body %}
<div class="wrap">
    <header>
        <nav class="topbar">
            {# FIXED: Changed app_home to app_login #}
            <a href="{{ path('app_login') }}" class="brand">
                <img src="{{ asset('resources/logo.svg') }}" alt=".INSAT" class="brand-logo">
            </a>
        </nav>
    </header>

    <main style="margin-top: 10vh; max-width: 400px; margin-inline: auto;">
        {% if error %}
            <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
        {% endif %}

        <form method="post" class="login-form">
            <h2 class="form-page-title">Connexion</h2>

            <div class="form-group">
                <label for="username">Email</label>
                <input type="email" value="{{ last_username }}" name="_username" id="username" class="form-control" autocomplete="email" required autofocus>
            </div>

            <div class="form-group">
                <label for="password">Mot de passe</label>
                <input type="password" name="_password" id="password" class="form-control" autocomplete="current-password" required>
            </div>

            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            <button class="etu-btn-primary" type="submit" style="width: 100%; margin-top: 20px;">
                Se connecter
            </button>
        </form>
    </main>
</div>
{% endblock %}
