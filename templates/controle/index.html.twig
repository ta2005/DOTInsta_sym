{% extends 'base.html.twig' %}

{% block title %}Controles{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css">
    <link rel="stylesheet" href="{{ asset('css/etudiants.css') }}">
{% endblock %}

{% block body %}
<div class="etu-page">
    <div class="etu-header">
        <h1 class="etu-header-title">Contrôles</h1>
        {% if is_granted('ROLE_ADMIN') %}
            <a href="{{ path('app_controle_new') }}" class="etu-btn-primary">Nouveau Contrôle</a>
        {% endif %}
    </div>

    <div class="etu-table-wrap">
        <table class="etu-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Type</th>
                    <th>Enseignement</th>
                    <th>Etudiant</th>
                    <th>Note</th>
                    <th>Statut</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for controle in controles %}
                <tr>
                    <td>{{ controle.id }}</td>
                    <td>{{ controle.type.value|default(controle.type) }}</td>
                    <td>{{ controle.enseignementId }}</td>
                    <td>{{ controle.etudiantId }}</td>
                    <td>{{ controle.note|default('-') }}</td>
                    <td>{{ controle.statut.value|default(controle.statut) }}</td>
                    <td class="etu-td-actions">
                        <a href="{{ path('app_controle_show', {'id': controle.id}) }}" class="etu-btn-icon" title="Voir"><i class="ti ti-eye"></i></a>
                        {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_ENSEIGNANT') %}
                            <a href="{{ path('app_controle_edit', {'id': controle.id}) }}" class="etu-btn-icon" title="Modifier"><i class="ti ti-pencil"></i></a>
                        {% endif %}
                        {% if is_granted('ROLE_ETUDIANT') and controle.statut.value != 'VERIFIE' %}
                            <a href="{{ path('app_reclamation_new', {'id': controle.id}) }}" class="etu-btn-icon" title="Faire une réclamation" style="color: #f59e0b; border: 1px solid rgba(245, 158, 11, 0.3);"><i class="ti ti-alert-triangle"></i></a>
                        {% endif %}
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="7" style="text-align: center; padding: 20px;">Aucun contrôle trouvé</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
