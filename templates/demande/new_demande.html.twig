{% extends 'base.html.twig' %}

{% block title %}New Request{% endblock %}

{% block body %}
    <h1>Submit a Request</h1>

    {{ form_start(form) }}
        {{ form_row(form.type) }}
        {{ form_row(form.message) }}

        <button type="submit">Submit Request</button>
    {{ form_end(form) }}
{% endblock %}
