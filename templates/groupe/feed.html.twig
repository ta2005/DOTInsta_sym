{% extends 'base.html.twig' %}

{% block title %}Fil d'actualité{% endblock %}

{% block body %}
<div class="blog-feed-container" style="max-width: 700px; margin: 0 auto;">
    <h1 style="color: var(--accent);">Flux du Blog</h1>

    {% for post in posts %}
        <article class="post-card" style="background: var(--surface); border: 1px solid var(--border); padding: 20px; border-radius: 12px; margin-bottom: 20px;">
            <header style="display: flex; justify-content: space-between;">
                <strong>{{ post.auteurId.prenom }} {{ post.auteurId.nom }}</strong>
                <span class="text-muted">{{ post.dateCreation|date('d M Y H:i') }}</span>
            </header>

            <p style="font-size: 1.1rem; margin: 15px 0;">{{ post.contenu }}</p>

            <div class="post-footer" style="border-top: 1px solid var(--border-light); padding-top: 10px;">
                <span class="badge"># {{ post.groupId.nom }}</span>

                <div class="comments-section" style="margin-top: 15px; padding-left: 20px; border-left: 2px solid var(--border-light);">
                    {% for com in post.commentaires %}
                        <div class="comment" style="margin-bottom: 8px;">
                            <strong>{{ com.auteurId.prenom }}:</strong> {{ com.contenu }}
                        </div>
                    {% endfor %}

                    <a href="{{ path('app_commentaire_new', {'id': post.id}) }}" class="btn-link" style="color: var(--green); font-size: 0.9rem;">
                        + Ajouter un commentaire
                    </a>
                </div>
            </div>
        </article>
    {% else %}
        <div class="empty-state">
            <p>Aucun message dans votre fil d'actualité.</p>
        </div>
    {% endfor %}
</div>
{% endblock %}
