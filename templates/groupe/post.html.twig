{% extends 'base.html.twig' %}

{% block title %}Blog du Groupe{% endblock %}

{% block body %}
<div class="blog-container">
    <h2>Flux d'actualité du groupe</h2>

    {# Button to create a new post #}
    <div style="margin-bottom: 20px;">
        <a href="{{ path('groupe_post_new', {'id': groupe.id}) }}" class="form-btn-primary">
            Rédiger un nouveau post
        </a>
    </div>

    <div class="posts-list">
        {% for post in posts %}
            <div class="post-card" style="border: 1px solid var(--border); padding: 15px; margin-bottom: 15px; border-radius: 8px;">
                <p class="post-content">{{ post.contenu }}</p>
                <small class="text-muted">Publié le {{ post.dateCreation|date('d/m/Y H:i') }}</small>

                <hr style="border-color: var(--border-light); margin: 10px 0;">

                {# Comments Section #}
                <div class="comments">
                    <h4>Commentaires :</h4>
                    {% for comment in post.commentaires %}
                        <div class="comment" style="margin-left: 15px; padding-bottom: 5px;">
                            <p>- {{ comment.contenu }}</p>
                        </div>
                    {% else %}
                        <p style="margin-left: 15px; color: var(--text-muted);">Aucun commentaire.</p>
                    {% endfor %}

                    <a href="{{ path('post_comment_new', {'id': post.id}) }}" style="font-size: 0.85rem; color: var(--green);">
                        + Ajouter un commentaire
                    </a>
                </div>
            </div>
        {% else %}
            <p>Il n'y a aucun post dans ce groupe pour le moment.</p>
        {% endfor %}
    </div>
</div>
{% endblock %}
