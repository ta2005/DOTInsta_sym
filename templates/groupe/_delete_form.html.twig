<form method="post" action="{{ path('app_groupe_delete', {'id': groupe.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce groupe ?');" style="display: inline-block; margin: 0;">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ groupe.id) }}">
    <button type="submit" class="etu-btn-danger">
        <i class="ti ti-trash"></i> Supprimer
    </button>
</form>
