{% extends 'base.html.twig' %}

{% block title %}Administration{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css">
    <link rel="stylesheet" href="{{ asset('css/etudiants.css') }}">
{% endblock %}

{% block body %}
<div class="etu-page">

    <div class="etu-header">
        <div class="etu-header-icon">
            <i class="ti ti-dashboard"></i>
        </div>
        <div>
            <h1 class="etu-header-title">Panneau d'Administration</h1>
            <p class="etu-header-sub">
                Gérez les utilisateurs, groupes et requêtes du système
            </p>
        </div>
    </div>

    <div class="etu-filter-card" style="display: flex; gap: 20px; flex-wrap: wrap;">

        <a href="{{ path('app_user_index') }}" class="etu-btn-primary" style="text-decoration: none;">
            <i class="ti ti-users"></i> Gérer les Utilisateurs
        </a>

        <a href="{{ path('app_groupe_index') }}" class="etu-btn-primary" style="text-decoration: none; background: #3b5a80;">
            <i class="ti ti-users-group"></i> Gérer les Groupes
        </a>

        <a href="{{ path('app_demande_index') }}" class="etu-btn-secondary" style="text-decoration: none;">
            <i class="ti ti-file-description"></i> Voir les Demandes
        </a>

    </div>

    <div class="etu-welcome" style="margin-top: 40px;">
        <div class="etu-welcome-icon">
            <i class="ti ti-shield-check"></i>
        </div>
        <p class="etu-welcome-msg">
            Bienvenue dans l'espace administrateur. Sélectionnez une option ci-dessus pour commencer.
        </p>
    </div>

</div>
{% endblock %}
